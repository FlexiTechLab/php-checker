{
    "name": "flexitechlab/php-checker",
    "description": "A PHP static analysis and coding rules checker powered by PHPStan.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "symfony/console": "^7.4",
        "symfony/process": "^7.0",
        "phpstan/phpstan": "^2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PhpChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpChecker\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/php-checker"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
